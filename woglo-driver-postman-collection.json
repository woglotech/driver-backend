    {
      "name": "🔗 Vendor Bridge (Server-to-Server)",
      "description": "These routes are called by the Vendor Backend — NOT directly by mobile apps.\nRequire: x-vendor-api-key header.",
      "item": [
        {
          "name": "Get Available Drivers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-vendor-api-key",
                "value": "{{vendor_api_key}}"
              }
            ],
            "url": "{{DRIVER_BASE_URL}}/vendor/drivers",
            "description": "Supports optional ?search=query param"
          }
        },
        {
          "name": "Send Vendor Request to Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-vendor-api-key",
                "value": "{{vendor_api_key}}"
              }
            ],
            "url": "{{DRIVER_BASE_URL}}/vendor/send-request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"<driver_id>\",\n  \"vendorId\": \"<vendor_id>\",\n  \"vendorName\": \"My Agency\",\n  \"message\": \"We'd like you to join our fleet\"\n}"
            }
          }
        },
        {
          "name": "Get Driver Calendar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-vendor-api-key",
                "value": "{{vendor_api_key}}"
              }
            ],
            "url": "{{DRIVER_BASE_URL}}/vendor/driver-calendar/:driverId",
            "variable": [
              {
                "key": "driverId",
                "value": "<driver_id>"
              }
            ]
          }
        },
        {
          "name": "Assign Vehicle to Driver",
          "request": {
